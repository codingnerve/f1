# ── Site ───────────────────────────────────────────────────────────────
# Canonical production URL used for canonical links, Open Graph, sitemap and share links.
NEXT_PUBLIC_SITE_URL=https://way2tickets.com

# Booking line used by every "Call to Book" button, the header, footer and contact page.
# Unset → placeholder +1 (212) 555-0142 (a reserved fictional number). SET THIS BEFORE LAUNCH.
NEXT_PUBLIC_CONTACT_PHONE=
# Optional: shown when set, hidden otherwise.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_HOURS=

# ── Enquiry API (optional, not used by the UI) ─────────────────────────
# The site books by phone. POST /api/enquiries remains available for a future form/CRM integration.
# "file"    → append JSON lines to ENQUIRY_FILE_PATH (needs a persistent, writable disk)
# "webhook" → POST each enquiry to ENQUIRY_WEBHOOK_URL (CRM, Zapier/Make, your own API)
# Unset     → "file" in development; in production the API returns 503 and says so honestly.
ENQUIRY_STORAGE=
ENQUIRY_FILE_PATH=.data/enquiries.jsonl
ENQUIRY_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <secret>" to the webhook.
ENQUIRY_WEBHOOK_SECRET=

# ── Optional team notification email (Resend HTTP API) ─────────────────
RESEND_API_KEY=
# Comma-separated recipients, and a verified sender address.
ENQUIRY_NOTIFY_TO=
ENQUIRY_NOTIFY_FROM=
